<Window x:Class="SDS_Convert.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SDS_Convert" Height="790" Width="1180" MinHeight="560" MinWidth="760"
        Icon="pack://application:,,,/Assets/Icons/SDS_Convert.ico"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" Loaded="Window_Loaded"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource AccentSurface}"
                        BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" Margin="0,0,12,0">
                    <Image Width="25" Height="25" Source="{StaticResource AppLogoImage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SDS_Convert" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Offline file converter" FontSize="11" Foreground="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FullscreenButton" Content="Full screen" Click="Fullscreen_Click"
                        Margin="0,0,8,0" ToolTip="Toggle full screen (F11; Escape to exit)" />
                <Border CornerRadius="6" Background="{StaticResource AccentSurface}"
                        BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                        Padding="10,7" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Files stay on this device" FontSize="11"
                                   Foreground="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="2" x:Name="MainTabs" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="12,9" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabChrome" Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Convert">
                <Grid Margin="0,10,0,0" TextElement.Foreground="{StaticResource PrimaryText}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeroRow" Height="Auto" />
                        <RowDefinition x:Name="HeroSpacerRow" Height="12" />
                        <RowDefinition x:Name="DropZoneRow" Height="148" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" x:Name="HeroPanel">
                        <TextBlock Text="A simpler way to convert files" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Choose what you need, keep the original, and save the result where you want it."
                                   Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                            Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource AccentBorder}"
                            BorderThickness="1" CornerRadius="9" Padding="18">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="30" Height="30" Source="{StaticResource AppLogoImage}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Drop files to add them to your queue" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Files are processed locally and the originals are left untouched."
                                           Foreground="{StaticResource SecondaryText}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,6,0,12" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Choose files" Click="AddFiles_Click" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Choose files to add (Ctrl+O)" Margin="0,0,8,0" />
                                    <Button Content="Choose folder" Click="AddFolder_Click"
                                            ToolTip="Import supported files from a folder (Ctrl+Shift+O)" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Conversion queue" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="QueueCount" Text="  ·  0 files" FontSize="11"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                            <Button Content="Add files" Click="AddFiles_Click" Margin="0,0,8,7"
                                    ToolTip="Add more files to the queue (Ctrl+O)" />
                            <Button Content="Add folder" Click="AddFolder_Click" Margin="0,0,8,7"
                                    ToolTip="Import more files from a folder (Ctrl+Shift+O)" />
                            <TextBox x:Name="BatchNamePatternBox" Width="176" Text="{}{name}_{date}"
                                     FontSize="12" Padding="10,6"
                                     VerticalAlignment="Center" Margin="0,0,8,7"
                                     ToolTip="Batch name pattern · {name}: original name · {format}: selected format · {date}: today" />
                            <Button x:Name="ApplyNamesButton" Content="Apply names" Click="ApplyNamePattern_Click" Margin="0,0,8,7"
                                    ToolTip="Apply this naming pattern to selected files (Ctrl+Shift+R)." />
                            <Button Content="Preview" Click="PreviewSelected_Click" Margin="0,0,8,7"
                                    ToolTip="Load a preview only when requested. Double-click a queue row to preview too." />
                            <Button Content="Merge PDFs" Click="MergePdfs_Click" Margin="0,0,8,7"
                                    ToolTip="Combine two or more selected PDF files locally." />
                            <Button Content="Split PDF" Click="SplitPdf_Click" Margin="0,0,8,7"
                                    ToolTip="Save each page of the selected PDF as a separate file." />
                            <Button Content="Remove selected" Click="RemoveSelected_Click" Margin="0,0,8,7"
                                    ToolTip="Remove selected files from the queue (Delete)" />
                        </WrapPanel>
                    </Grid>

                    <Expander Grid.Row="6" x:Name="ImageOptions" Header="Image settings  ·  apply to selected image"
                             Foreground="{StaticResource PrimaryText}" Background="{StaticResource PanelBackground}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10"
                             IsExpanded="False" Expanded="ImageOptions_Expanded">
                        <WrapPanel Margin="4,12,4,4">
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="Width · px" FontSize="10" Foreground="{StaticResource MutedText}" />
                                <TextBox x:Name="ImageWidthBox" Width="78" Text="0" MaxLength="10" Margin="0,4,0,0"
                                         LostFocus="ImageOptions_Changed" ToolTip="Set 0 to keep the original width." />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="Height · px" FontSize="10" Foreground="{StaticResource MutedText}" />
                                <TextBox x:Name="ImageHeightBox" Width="78" Text="0" MaxLength="10" Margin="0,4,0,0"
                                         LostFocus="ImageOptions_Changed" ToolTip="Set 0 to keep the original height." />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="JPEG quality" FontSize="10" Foreground="{StaticResource MutedText}" />
                                <Slider x:Name="ImageQualitySlider" Width="120" Minimum="1" Maximum="100" Value="90"
                                        TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="ImageQuality_Changed"
                                        ToolTip="Lower quality creates smaller JPEGs with more visible compression." />
                                <TextBlock x:Name="ImageQualityText" Text="90" FontSize="9"
                                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="Rotate" FontSize="10" Foreground="{StaticResource MutedText}" />
                                <ComboBox x:Name="RotationBox" Width="90" SelectedIndex="0" Margin="0,4,0,0"
                                          SelectionChanged="ImageOptions_Changed">
                                    <ComboBoxItem Content="0°" Tag="0" />
                                    <ComboBoxItem Content="90°" Tag="90" />
                                    <ComboBoxItem Content="180°" Tag="180" />
                                    <ComboBoxItem Content="270°" Tag="270" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="FlipHorizontalBox" Content="Flip horizontal" VerticalAlignment="Bottom"
                                      Margin="0,0,16,14" Checked="ImageOptions_Changed" Unchecked="ImageOptions_Changed" />
                            <CheckBox x:Name="FlipVerticalBox" Content="Flip vertical" VerticalAlignment="Bottom"
                                      Margin="0,0,16,14" Checked="ImageOptions_Changed" Unchecked="ImageOptions_Changed" />
                            <TextBlock Text="Resize keeps aspect ratio." VerticalAlignment="Bottom" Margin="0,0,0,16"
                                       Foreground="{StaticResource MutedText}" FontSize="11" />
                        </WrapPanel>
                    </Expander>

                    <DataGrid Grid.Row="8" x:Name="QueueGrid" ItemsSource="{Binding Jobs}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" Background="{StaticResource PanelBackground}" Foreground="{StaticResource PrimaryText}"
                              BorderBrush="{StaticResource BorderBrush}" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="QueueGrid_SelectionChanged"
                              MouseDoubleClick="QueueGrid_MouseDoubleClick"
                              ToolTip="Select rows for PDF tools. Double-click a row to preview its source." >
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource RaisedBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Padding" Value="10,10" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{StaticResource PanelBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="MinHeight" Value="60" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSurface}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSurface}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="QueueFormatComboBox" TargetType="ComboBox"
                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Background" Value="{StaticResource InputBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="{StaticResource RaisedBackground}" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                            <Setter Property="Padding" Value="10,7" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSurface}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSurface}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid SnapsToDevicePixels="True">
                                                <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              ClickMode="Press" Focusable="False"
                                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              Background="{TemplateBinding Background}"
                                                              BorderBrush="{TemplateBinding BorderBrush}"
                                                              BorderThickness="0">
                                                    <Border x:Name="Chrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="24" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                              VerticalAlignment="Center"
                                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                                            <Path x:Name="DropDownArrow" Grid.Column="1"
                                                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                                                  Fill="{TemplateBinding Foreground}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </ToggleButton>
                                                <Popup x:Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Fade">
                                                    <Border Background="{StaticResource RaisedBackground}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="3"
                                                            MinWidth="{TemplateBinding ActualWidth}">
                                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                                      SnapsToDevicePixels="True">
                                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <Trigger Property="IsDropDownOpen" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="DropDownArrow" Property="Data" Value="M 0 5 L 8 5 L 4 0 Z" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="File" Width="2.2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Size" Width="0.7*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Format" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding OutputExtension, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource QueueFormatComboBox}"
                                                  ToolTip="Choose a supported local output format." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Output name" Width="1.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding OutputNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" Padding="9,6"
                                                     ToolTip="Output name · {name}: original name · {format}: selected format · {date}: today" />
                                            <TextBlock Text="{Binding OutputFolderLabel}" FontSize="9"
                                                       Foreground="{StaticResource MutedText}" Margin="2,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="1.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" />
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3"
                                                         Margin="0,6,0,0" Background="{StaticResource RaisedBackground}"
                                                         Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryText}"
                                                       FontSize="10" TextWrapping="Wrap" ToolTip="{Binding Message}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="10" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Save to" Foreground="{StaticResource MutedText}" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox x:Name="OutputFolderBox" Width="220" IsReadOnly="True"
                                     ToolTip="Converted files will be saved here." Margin="0,0,0,6" />
                            <Button x:Name="ChooseOutputButton" Content="Browse" Click="ChooseOutput_Click" Margin="7,0,7,6"
                                    ToolTip="Choose an output folder." />
                            <Button x:Name="SetSelectedOutputButton" Content="Set for selected" Click="SetSelectedOutput_Click" Margin="0,0,7,6"
                                    ToolTip="Set a separate output folder for selected queue files." />
                            <Button x:Name="UseBatchOutputButton" Content="Use batch folder" Click="UseBatchOutput_Click" Margin="0,0,7,6"
                                    ToolTip="Clear selected files' folder overrides." />
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                                    Visibility="Collapsed" Margin="0,0,8,0" />
                            <Button Content="Clear queue" Click="ClearQueue_Click" Margin="0,0,8,0" />
                            <Button x:Name="ConvertButton" Click="Convert_Click"
                                    Style="{StaticResource PrimaryButton}" ToolTip="Convert ready files (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16" Height="16" Source="{StaticResource ConvertGlyphImage}"
                                           Margin="0,0,8,0" />
                                    <TextBlock Text="Convert files" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Recent">
                <Grid Margin="0,18,0,0" TextElement.Foreground="{StaticResource PrimaryText}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Recent conversions" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Your conversion history stays on this device."
                                   Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource PrimaryText}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="RecentList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="14,12" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="{StaticResource PanelBackground}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSurface}" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" />
                                        <TextBlock Text="{Binding InputPath}" FontSize="11"
                                                   Foreground="{StaticResource MutedText}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="RecentEmptyState" Text="Completed conversions will appear here."
                                   Foreground="{StaticResource MutedText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Help" ToolTip="Search the in-app guides (F1)">
                <Grid Margin="0,18,0,0" TextElement.Foreground="{StaticResource PrimaryText}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Help &amp; format guide" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Find quick answers about converting files on this device."
                                       Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="HelpSearchBox" VerticalAlignment="Center"
                                     TextChanged="HelpSearch_TextChanged"
                                     ToolTip="Search guide titles and descriptions."
                                     AutomationProperties.Name="Search help guides" />
                            <TextBlock x:Name="HelpSearchPlaceholder" Text="Search help topics..."
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedText}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Guides" Margin="8,6,8,10" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
                                <ListBox Grid.Row="1" x:Name="HelpList" Background="Transparent"
                                         BorderThickness="0" Foreground="{StaticResource PrimaryText}"
                                         SelectionChanged="HelpList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSurface}" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource RaisedBackground}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="HelpEmptyState" Grid.Row="1"
                                           Text="No guides match your search." TextWrapping="Wrap"
                                           Margin="12,18" Foreground="{StaticResource MutedText}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="SDS_Convert  /  Help" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="HelpArticleTitle" Text="Choose a guide"
                                               FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Margin="0,12,0,14" />
                                    <Border Height="1" Background="{StaticResource BorderBrush}" />
                                    <TextBlock x:Name="HelpArticleBody"
                                               Text="Select a topic from the list to see step-by-step guidance."
                                               TextWrapping="Wrap" FontSize="14" LineHeight="24"
                                               Foreground="{StaticResource SecondaryText}" Margin="0,18,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="11,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready · Local conversion only · No online fallback is configured"
                           Foreground="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock Grid.Column="1" Text="{Binding LibreOfficeStatus}"
                           Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
